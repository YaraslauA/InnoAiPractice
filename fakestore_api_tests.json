{
	"info": {
		"_postman_id": "1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p",
		"name": "Fake Store API Tests",
		"description": "Test scenarios for Fake Store API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get Products",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "https://fakestoreapi.com/products",
					"protocol": "https",
					"host": ["fakestoreapi", "com"],
					"path": ["products"]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test for 200 status code",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Parse the response body",
							"const response = pm.response.json();",
							"",
							"// Initialize arrays for valid and invalid products",
							"let validProducts = [];",
							"let invalidProducts = [];",
							"",
							"// Test each product in the response",
							"response.forEach(function(product) {",
							"    // Check if product has required fields and valid rating",
							"    if (product.title && product.price && product.rating && product.rating.rate < 5) {",
							"        validProducts.push(product);",
							"    } else {",
							"        invalidProducts.push(product);",
							"    }",
							"});",
							"",
							"// Log the results",
							"console.log(\"Valid Products:\", validProducts);",
							"console.log(\"Invalid Products:\", invalidProducts);",
							"",
							"// Test that all products have title field",
							"pm.test(\"All products have title field\", function () {",
							"    response.forEach(function(product) {",
							"        pm.expect(product).to.have.property('title');",
							"    });",
							"});",
							"",
							"// Test that all products have price field",
							"pm.test(\"All products have price field\", function () {",
							"    response.forEach(function(product) {",
							"        pm.expect(product).to.have.property('price');",
							"    });",
							"});",
							"",
							"// Test that all products have rating.rate field less than 5",
							"pm.test(\"All products have rating.rate less than 5\", function () {",
							"    response.forEach(function(product) {",
							"        pm.expect(product.rating.rate).to.be.below(5);",
							"    });",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		}
	]
} 